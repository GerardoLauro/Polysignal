# PolySignal — environment configuration template.
# Copy this file to ".env" and fill in your local values.
# Do NOT commit the real .env file.
# ----------------------------------------------------------------------------
# General runtime
# ----------------------------------------------------------------------------
POLYSIGNAL_ENV=local
POLYSIGNAL_LOG_LEVEL=INFO
POLYSIGNAL_DATA_DIR=./data
# ----------------------------------------------------------------------------
# Polymarket
# ----------------------------------------------------------------------------
# Public Polymarket / CLOB endpoints. These are documented public APIs; no key
# is required for read-only ingestion. The values below are placeholders that
# match the typical public layout; verify them in the official Polymarket docs
# before enabling real ingestion.
POLYMARKET_GAMMA_API_BASE=https://gamma-api.polymarket.com
POLYMARKET_CLOB_API_BASE=https://clob.polymarket.com
POLYMARKET_REQUEST_TIMEOUT_SECONDS=30
POLYMARKET_USER_AGENT=PolySignal-Research/0.1
# ----------------------------------------------------------------------------
# Reddit
# ----------------------------------------------------------------------------
# Reddit is collected via Scrapling public-web (old.reddit.com) ONLY — see
# scripts\collect_scrapling_web.cmd. The Reddit OAuth API is intentionally NOT
# used by this project, so no Reddit credentials are required or read.
# ----------------------------------------------------------------------------
# X / Twitter
# ----------------------------------------------------------------------------
# Optional X/Twitter adapters. Nothing is collected until explicitly requested.
# API and browser-session credentials are local-only and optional.
TWITTER_BEARER_TOKEN=
X_AUTH_TOKEN=
X_CT0=
# ----------------------------------------------------------------------------
# Telegram
# ----------------------------------------------------------------------------
# Telegram ingestion requires creating an application at https://my.telegram.org
# and using a user-mode client (e.g. Telethon). Channel access depends on the
# channel being public or the user being a member. Leave empty if not used.
POLYSIGNAL_TELEGRAM_API_ID=
POLYSIGNAL_TELEGRAM_API_HASH=
POLYSIGNAL_TELEGRAM_SESSION_NAME=polysignal_telegram
POLYSIGNAL_TELEGRAM_SESSION_DIR=data/cache/telegram
# ----------------------------------------------------------------------------
# Neo4j (knowledge graph)
# ----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=polysignal-dev
NEO4J_DATABASE=neo4j
# ----------------------------------------------------------------------------
# LLM provider (optional)
# ----------------------------------------------------------------------------
# The system is designed so that LLM usage is OPTIONAL and CONTROLLED.
# Leave these unset to disable LLM-assisted features entirely.
POLYSIGNAL_LLM_PROVIDER=disabled        # one of: disabled | openai | anthropic
POLYSIGNAL_LLM_MODEL=
POLYSIGNAL_OPENAI_API_KEY=
POLYSIGNAL_ANTHROPIC_API_KEY=
POLYSIGNAL_LLM_TEMPERATURE=0.0
POLYSIGNAL_LLM_TIMEOUT_SECONDS=30
POLYSIGNAL_LLM_MAX_TOKENS=512
POLYSIGNAL_LLM_CACHE_DIR=./data/cache/llm
# Optional: route Anthropic traffic through a custom/proxy gateway. Leave the
# token blank in this template — fill it only in your local, untracked .env.
# ANTHROPIC_BASE_URL=
# ANTHROPIC_AUTH_TOKEN=
